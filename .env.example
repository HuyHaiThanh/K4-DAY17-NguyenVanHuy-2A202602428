# Copy to .env and set your own model IDs/credentials for live mode.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Optional separate judge configuration; omitted values inherit compatible main config.
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o-mini
JUDGE_API_KEY=
COMPACT_THRESHOLD_TOKENS=1000
COMPACT_KEEP_MESSAGES=4
PROFILE_CONFIDENCE_THRESHOLD=0.8
MEMORY_HALF_LIFE_DAYS=30
MEMORY_MIN_PRIORITY=0.25
